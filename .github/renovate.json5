{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  commitBody: 'Signed-off-by: Sebastian Gaiser <sebastiangaiser@users.noreply.github.com>',
  extends: [
    'config:recommended',
    'github>prometheus-community/helm-charts//renovate.json',
  ],
  semanticCommits: 'enabled',
  'pre-commit': {
    enabled: true,
  },
  ignorePaths: [
    'charts/capacitor/**',
  ],
  packageRules: [
    {
      description: 'The prometheus-community/helm-charts preset disables every package outside charts/ and .github/workflows/, so re-enable the hook versions in .pre-commit-config.yaml.',
      matchFileNames: ['.pre-commit-config.yaml'],
      enabled: true,
    },
    {
      description: 'Auto-merge non-major dependency updates already flagged for auto-merge (Helm charts + CI workflows). Major bumps stay manual.',
      matchFileNames: ['charts/**', '.github/workflows/**'],
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      automerge: true,
    },
    {
      matchPackageNames: ['kindest/node'],
      separateMultipleMinor: true,
    },
    {
      description: 'The tested Kubernetes minors are a conscious choice, only patch bumps are automatic.',
      matchPackageNames: ['kindest/node'],
      matchUpdateTypes: ['major', 'minor'],
      enabled: false,
    },
  ],
}
